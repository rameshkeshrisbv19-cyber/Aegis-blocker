<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppBlocker" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/aegis_bg</item>
    </style>

    <style name="Theme.AppBlocker.Block" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aegis_bg</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/aegis_bg</item>
    </style>
</resources>
